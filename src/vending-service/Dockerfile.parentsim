# Build parentsim — the Go test-harness parent (NOT the Python agent, parent.py).
# See cmd/parentsim/main.go's doc comment for what this is and is not.
FROM golang:1.26 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/parentsim ./cmd/parentsim

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/parentsim /parentsim
USER 65532:65532
ENTRYPOINT ["/parentsim"]
